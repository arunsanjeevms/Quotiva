# Public values only. Vite exposes every VITE_ prefixed variable to the browser.
# Never place a service-role key, SMTP password or DATABASE_URL in this file.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to "false" once a real backend is running to disable the MSW mock API.
VITE_ENABLE_MOCKS=true
