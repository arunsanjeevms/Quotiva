# Public values only. Vite exposes every VITE_ prefixed variable to the browser.
# Never place a service-role key, SMTP password or DATABASE_URL in this file.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Mocks are opt-in: ONLY the exact value "true" enables the MSW mock API and
# its fake auth. Anything else (blank, missing, "false") uses the real backend.
VITE_ENABLE_MOCKS=true
